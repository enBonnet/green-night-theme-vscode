{
    "name": "green-night-theme",
    "version": "1.0.0",
    "displayName": "Green Night Theme",
    "description": "Green Night Theme for Visual Studio Code",
    "publisher": "enbonnet",
    "license": "MIT",
    "scripts": {
        "build": "node ./scripts/build.js",
        "lint": "node ./scripts/lint.js",
        "package": "mkdir -p ./bin && vsce package -o ./bin/green-night.vsix",
        "vscode:prepublish": "npm run build",
        "vsce:publish": "vsce publish"
    },
    "maintainers": [
        "Ender Bonnet"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/enBonnet/greeny-theme-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/enBonnet/greeny-theme-vscode/issues"
    },
    "engines": {
        "vscode": "^1.13.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "jade",
        "green-night",
        "green",
        "dark",
        "theme",
        "color-theme"
    ],
    "icon": "images/icon.png",
    "contributes": {
        "themes": [
            {
                "label": "Green Night Theme",
                "uiTheme": "vs-dark",
                "path": "./theme/green-night.json"
            },
            {
                "label": "Green Night Theme Soft",
                "uiTheme": "vs-dark",
                "path": "./theme/green-night-soft.json"
            }
        ]
    },
    "devDependencies": {
        "js-yaml": "^4.1.1",
        "prettier": "^3.0.0",
        "tinycolor2": "^1.6.0",
        "vsce": "^2.15.0"
    }
}